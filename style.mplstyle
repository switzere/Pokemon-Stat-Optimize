# --- Figure ---
figure.figsize: 10, 6
figure.dpi: 120

# --- Axes ---
axes.titlesize: 16
axes.titleweight: bold
axes.labelsize: 14
axes.linewidth: 1.0

# --- Lines ---
lines.linewidth: 2.5
lines.markersize: 6

# --- Ticks ---
xtick.labelsize: 12
ytick.labelsize: 12
xtick.major.width: 1.0
ytick.major.width: 1.0

# --- Grid ---
grid.color: black
grid.linewidth: 0.8
grid.alpha: 0.4

# --- Font ---
font.size: 12

# --- Legend ---
legend.fontsize: 12

# --- Background ---
figure.facecolor: (0.765, 0.902, 0.941)
axes.facecolor: (0.765, 0.902, 0.941)